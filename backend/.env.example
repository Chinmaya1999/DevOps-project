PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/mernapp

# --- Required secrets (the server refuses to start in production without them) ---
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
# 64 hex chars. Encrypts users' SSH keys in the database. LOSING THIS KEY MAKES STORED KEYS UNRECOVERABLE — back it up.
DATA_ENCRYPTION_KEY=

JWT_EXPIRES_IN=1d
# Set to 1 when running behind nginx / a load balancer so rate limits use the real client IP
TRUST_PROXY=1

EMAIL_USER=
EMAIL_PASS=

# --- Cashfree Payment Gateway (Dashboard -> Payment Gateway -> Developers -> API Keys) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production            # or: sandbox (use sandbox keys while testing)
FRONTEND_URL=https://cmcloud.online
API_PUBLIC_URL=https://api.cmcloud.online

# --- Sessions ---
# Cookies are Secure (HTTPS-only) in production. Set to false ONLY for plain-http local development.
COOKIE_SECURE=true

# --- Billing ---
REFUND_WINDOW_DAYS=7
INVOICE_SELLER_NAME=AutoDevOps
INVOICE_SELLER_ADDRESS=
INVOICE_TAX_ID=
INVOICE_SELLER_EMAIL=
