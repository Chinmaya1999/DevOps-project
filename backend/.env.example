PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/mernapp

# --- Required secrets (the server refuses to start in production without them) ---
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
# 64 hex chars. Encrypts users' SSH keys in the database. LOSING THIS KEY MAKES STORED KEYS UNRECOVERABLE — back it up.
DATA_ENCRYPTION_KEY=

JWT_EXPIRES_IN=1d
# Set to 1 when running behind nginx / a load balancer so rate limits use the real client IP
TRUST_PROXY=1

EMAIL_USER=
EMAIL_PASS=

# --- Cashfree Payment Gateway (Dashboard -> Payment Gateway -> Developers -> API Keys) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production            # production | sandbox
# Test-mode keys (Cashfree dashboard -> toggle "Test mode" -> Developers -> API Keys). Used when CASHFREE_ENV=sandbox.
# Use sandbox for local development: live keys only work from a domain you have whitelisted, never from localhost.
CASHFREE_SANDBOX_APP_ID=
CASHFREE_SANDBOX_SECRET_KEY=
FRONTEND_URL=https://cmcloud.online
API_PUBLIC_URL=https://api.cmcloud.online

# --- Sessions ---
# Cookies are Secure (HTTPS-only) in production. Set to false ONLY for plain-http local development.
COOKIE_SECURE=true

# --- Billing ---
REFUND_WINDOW_DAYS=7
INVOICE_SELLER_NAME=DeployDojo
INVOICE_SELLER_ADDRESS=
INVOICE_TAX_ID=
INVOICE_SELLER_EMAIL=

# ── Linux sandbox (optional) ─────────────────────────────────────────────
# Learners get a real terminal inside a locked-down, throw-away container. See docs/sandbox.md BEFORE enabling:
# the backend needs Docker access, which is root-equivalent, so point it at a DEDICATED sandbox host over TLS.
SANDBOX_ENABLED=false
# SANDBOX_DOCKER_HOST=tcp://sandbox-host.internal:2376
# SANDBOX_DOCKER_TLS_DIR=/run/secrets/sandbox-docker-tls     # ca.pem, cert.pem, key.pem
# SANDBOX_IMAGE=cmdevops-sandbox:latest
# SANDBOX_RUNTIME=runsc            # gVisor, strongly recommended
# SANDBOX_MAX_SESSIONS=20
# SANDBOX_MEMORY_MB=128
# SANDBOX_CPUS=0.25
# SANDBOX_PIDS=64
# SANDBOX_IDLE_MINUTES=10
# ANTHROPIC_API_KEY=               # enables the optional AI tutor ("Ask AI" hints)
